DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# IS OIDC issuer (must match the token's iss exactly)
IS_ISSUER=https://identity.example.com
# Nexus-specific audience; IS must issue an access token for this audience
IS_AUDIENCE=nexus-api
# Optional only if IS discovery is nonstandard; HTTPS and same trusted identity origin recommended
# IS_JWKS_URL=https://identity.example.com/.well-known/jwks.json
